@model List<WalletSummary>
@{ViewData["Title"]="Ví";var vi=CultureInfo.GetCultureInfo("vi-VN");}
<div class="topline"><div><h1>Ví của tôi</h1><p class="muted">Số dư ban đầu + tổng thu − tổng chi. Số âm phản ánh dữ liệu chi đã ghi vượt nguồn tiền đã ghi; hãy kiểm tra số dư ban đầu, khoản thu và ví sử dụng.</p></div><a class="button" asp-action="Edit">+ Thêm ví</a></div>
<div class="grid">@foreach(var x in Model){<section class="panel stat"><h2>@x.Wallet.Name</h2><div class="label">Số dư hiện tại</div><div class="value @(x.Balance<0?"expense":"")">@x.Balance.ToString("#,##0.##",vi) ₫</div><p class="note">Ban đầu: @x.Wallet.OpeningBalance.ToString("#,##0.##",vi) ₫</p><div class="actions"><a class="button secondary small" asp-action="Edit" asp-route-id="@x.Wallet.Id">Chỉnh sửa</a><form asp-action="Delete" method="post" data-confirm="Xóa ví này? Ví đang có giao dịch sẽ không được xóa."><input type="hidden" name="id" value="@x.Wallet.Id"/><button class="danger small">Xóa</button></form></div></section>}</div>@if(Model.Count==0){<div class="panel empty">Bạn chưa có ví. Hãy thêm ví để bắt đầu ghi thu chi.</div>}