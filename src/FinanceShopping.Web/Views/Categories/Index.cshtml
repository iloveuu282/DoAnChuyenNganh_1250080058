@model List<Category>
@{ViewData["Title"]="Danh mục";}
<div class="topline"><div><h1>Danh mục thu chi</h1><p class="muted">Danh mục được phân biệt bằng mã; tên trùng được phép và vẫn thống kê riêng.</p></div><a class="button" asp-action="Edit">+ Thêm danh mục</a></div><div class="panel table-wrap"><table><thead><tr><th>Tên danh mục</th><th>Loại</th><th>Thao tác</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name <span class="note">(#@c.Id)</span></td><td><span class="badge">@(c.Type==FlowType.Income?"Thu nhập":"Chi tiêu")</span></td><td><div class="actions"><a asp-action="Edit" asp-route-id="@c.Id">Sửa</a><form asp-action="Delete" method="post" data-confirm="Xóa danh mục này?"><input type="hidden" name="id" value="@c.Id"/><button class="danger small">Xóa</button></form></div></td></tr>}</tbody></table>@if(Model.Count==0){<p class="empty">Chưa có danh mục.</p>}</div>