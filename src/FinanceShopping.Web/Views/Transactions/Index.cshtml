@model List<Transaction>
@{ViewData["Title"]="Thu chi";var vi=CultureInfo.GetCultureInfo("vi-VN");}
<div class="topline"><div><h1>Giao dịch thu chi</h1><span class="muted">@ViewBag.Count giao dịch phù hợp bộ lọc</span></div><a class="button" asp-action="Edit">+ Ghi thu chi</a></div>
<form class="panel filters" method="get"><div class="field"><label for="from">Từ ngày</label><input name="from" id="from" type="date" value="@(ViewBag.From?.ToString("yyyy-MM-dd"))"/></div><div class="field"><label for="to">Đến ngày</label><input name="to" id="to" type="date" value="@(ViewBag.To?.ToString("yyyy-MM-dd"))"/></div><div class="field"><label for="type">Loại</label><select id="type" name="type"><option value="">Tất cả</option><option value="1" selected="@(ViewBag.Type==FlowType.Income)">Thu nhập</option><option value="2" selected="@(ViewBag.Type==FlowType.Expense)">Chi tiêu</option></select></div><div class="field"><label for="category">Danh mục</label><select id="category" name="category"><option value="">Tất cả</option>@foreach(Category c in ViewBag.Categories){<option value="@c.Id" selected="@(ViewBag.Category==c.Id)">@c.Name (#@c.Id)</option>}</select></div><button>Lọc giao dịch</button><a asp-action="Index">Xóa bộ lọc</a></form>
<div class="panel table-wrap"><table><thead><tr><th>Ngày</th><th>Nội dung / danh mục</th><th>Ví</th><th class="number">Số tiền</th><th>Thao tác</th></tr></thead><tbody>@foreach(var t in Model){<tr><td>@t.Date.ToString("dd/MM/yyyy")</td><td><strong>@t.Category.Name</strong><br/><span class="note">@t.Note</span></td><td>@t.Wallet.Name</td><td class="number @(t.Type==FlowType.Income?"income":"expense")">@(t.Type==FlowType.Income?"+":"−")@t.Amount.ToString("#,##0.##",vi) ₫</td><td>@if(t.ShoppingListId.HasValue){<a asp-controller="Shopping" asp-action="Details" asp-route-id="@t.ShoppingListId">Xem danh sách mua</a>}else{<div class="actions"><a asp-action="Edit" asp-route-id="@t.Id">Sửa</a><form asp-action="Delete" method="post" data-confirm="Xóa giao dịch này? Số dư và ngân sách sẽ được tính lại."><input type="hidden" name="id" value="@t.Id"/><button class="danger small">Xóa</button></form></div>}</td></tr>}</tbody></table>@if(Model.Count==0){<p class="empty">Chưa có giao dịch phù hợp.</p>}
<div class="pagination">@if(ViewBag.Page>1){<a asp-action="Index" asp-route-page="@(ViewBag.Page-1)" asp-route-from="@(ViewBag.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(ViewBag.To?.ToString("yyyy-MM-dd"))" asp-route-type="@((int?)ViewBag.Type)" asp-route-category="@ViewBag.Category">Trang trước</a>}<span>Trang @ViewBag.Page / @ViewBag.Pages</span>@if(ViewBag.Page<ViewBag.Pages){<a asp-action="Index" asp-route-page="@(ViewBag.Page+1)" asp-route-from="@(ViewBag.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(ViewBag.To?.ToString("yyyy-MM-dd"))" asp-route-type="@((int?)ViewBag.Type)" asp-route-category="@ViewBag.Category">Trang sau</a>}</div></div>