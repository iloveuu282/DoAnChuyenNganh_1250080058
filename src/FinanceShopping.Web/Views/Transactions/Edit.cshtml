@model TransactionForm
@{ViewData["Title"]="Ghi thu chi";}
<h1>@(Model.Id==0?"Ghi thu chi":"Sửa giao dịch")</h1><section class="panel form"><p class="note">Tạo ví và danh mục trước khi ghi giao dịch. Nhập số tiền không kèm dấu phân cách hàng nghìn.</p><form asp-action="Edit" method="post"><div asp-validation-summary="All"></div><input asp-for="Id" type="hidden"/>
<div class="grid"><div class="field"><label asp-for="Type">Loại giao dịch</label><select asp-for="Type" data-flow><option value="1">Thu nhập</option><option value="2">Chi tiêu</option></select></div><div class="field"><label asp-for="Date">Ngày giao dịch</label><input asp-for="Date" type="date" required min="1900-01-01" max="2100-12-31"/></div></div>
<div class="field"><label asp-for="WalletId">Ví</label><select asp-for="WalletId" required><option value="">Chọn ví</option>@foreach(Wallet w in ViewBag.Wallets){<option value="@w.Id">@w.Name</option>}</select></div>
<div class="field"><label asp-for="CategoryId">Danh mục</label><select asp-for="CategoryId" required data-categories><option value="">Chọn danh mục đúng loại thu/chi</option>@foreach(Category c in ViewBag.Categories){<option value="@c.Id" data-type="@((int)c.Type)">@c.Name (#@c.Id) (@(c.Type==FlowType.Income?"Thu":"Chi"))</option>}</select></div>
<div class="field"><label asp-for="Amount">Số tiền (VND)</label><input asp-for="Amount" type="number" step="0.01" min="0.01" max="999999999999" required/></div><div class="field"><label asp-for="Note">Ghi chú</label><textarea asp-for="Note" maxlength="300"></textarea></div><div class="actions"><button>Lưu giao dịch</button><a class="button secondary" asp-action="Index">Quay lại</a></div></form></section>