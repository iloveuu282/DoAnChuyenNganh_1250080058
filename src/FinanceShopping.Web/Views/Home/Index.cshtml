@model Overview
@{ViewData["Title"]="Tổng quan"; var vi=CultureInfo.GetCultureInfo("vi-VN");string Money(decimal n)=>n.ToString("#,##0.##",vi)+" ₫";}
<div class="topline"><div><h1>Tổng quan tài chính</h1><span class="muted">Ghi chép hôm nay, chủ động cho ngày mai.</span></div><a class="button" asp-controller="Transactions" asp-action="Edit">+ Ghi thu chi</a></div>
<form class="panel filters" method="get"><div class="field"><label for="from">Từ ngày</label><input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")"/></div><div class="field"><label for="to">Đến ngày</label><input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")"/></div><div class="field"><label for="month">Tháng ngân sách / biểu đồ</label><input id="month" name="month" type="month" value="@Model.Month.ToString("yyyy-MM")"/></div><button>Xem kết quả</button></form>
<div class="grid"><div class="panel stat"><div class="label">Tổng thu trong khoảng đã chọn</div><div class="value income">@Money(Model.Income)</div></div><div class="panel stat"><div class="label">Tổng chi trong khoảng đã chọn</div><div class="value expense">@Money(Model.Expense)</div></div><div class="panel stat"><div class="label">Tổng số dư hiện tại · tất cả ví</div><div class="value">@Money(Model.Wallets.Sum(x=>x.Balance))</div></div></div>
<div class="panel"><h2>Ngân sách tháng @Model.Month.ToString("MM/yyyy")</h2>
@if(Model.Budget.HasValue){var remaining=Model.Budget.Value-Model.MonthExpense;<div class="grid"><div>Hạn mức: <strong>@Money(Model.Budget.Value)</strong></div><div>Đã chi: <strong>@Money(Model.MonthExpense)</strong></div><div>Còn lại: <strong class="@(remaining<0?"expense":"income")">@Money(remaining)</strong></div></div>@if(remaining<0){<p class="notice warning">Đã vượt ngân sách. Khoản chi thực tế vẫn được ghi nhận.</p>}}else{<p>Chưa thiết lập ngân sách tháng này. <a asp-controller="Budgets" asp-action="Index" asp-route-month="@Model.Month.ToString("yyyy-MM-dd")">Thiết lập ngân sách</a></p>}</div>
<div class="grid"><section class="panel"><h2>Chi theo danh mục · @Model.Month.ToString("MM/yyyy")</h2>
@if(Model.Chart.Count==0){<p class="empty">Chưa có khoản chi trong tháng.</p>}else{foreach(var entry in Model.Chart){var pct=Model.MonthExpense==0?0:entry.Amount/Model.MonthExpense*100;<div class="bar-row"><div class="bar-label"><span>@entry.Name</span><strong>@Money(entry.Amount) · @pct.ToString("0.0")%</strong></div><div class="bar-track" role="img" aria-label="@entry.Name: @Money(entry.Amount)"><div class="bar" style="width:@pct.ToString("0.00",CultureInfo.InvariantCulture)%"></div></div></div>}}</section>
<section class="panel"><h2>Số dư ví hiện tại</h2>@if(Model.Wallets.Count==0){<p class="empty">Chưa có ví. <a asp-controller="Wallets" asp-action="Edit">Tạo ví đầu tiên</a></p>}@foreach(var w in Model.Wallets){<div class="bar-label bar-row"><span>@w.Wallet.Name</span><strong class="@(w.Balance<0?"expense":"")">@Money(w.Balance)</strong></div>}<p class="note">Số dư tính từ toàn bộ giao dịch hiện có, không giới hạn theo bộ lọc ngày.</p></section></div>