@model BudgetForm
@{ViewData["Title"]="Ngân sách";var vi=CultureInfo.GetCultureInfo("vi-VN");decimal? remain=(decimal?)ViewBag.Remaining;}
<h1>Ngân sách theo tháng</h1><p class="muted">Một hạn mức chung cho tổng chi của tất cả ví.</p><form method="get" class="panel filters form"><div class="field"><label for="selected-month">Chọn tháng cần xem</label><input id="selected-month" name="month" type="month" value="@Model.Month.ToString("yyyy-MM")" required/></div><button>Xem tháng</button></form>
<section class="panel form"><h2>Tháng @Model.Month.ToString("MM/yyyy")</h2>@if(remain.HasValue){<p>Đã chi: <strong>@((Model.Limit-remain.Value).ToString("#,##0.##",vi)) ₫</strong></p><p>Còn lại: <strong class="@(remain<0?"expense":"income")">@remain.Value.ToString("#,##0.##",vi) ₫</strong></p>@if(remain<0){<p class="notice warning">Chi tiêu đã vượt hạn mức.</p>}}else{<p>Chưa thiết lập ngân sách cho tháng này.</p>}
<form asp-action="Save" method="post"><input asp-for="Month" type="hidden" value="@Model.Month.ToString("yyyy-MM-dd")"/><div class="field"><label asp-for="Limit">Hạn mức tháng (VND)</label><input asp-for="Limit" type="number" step="0.01" min="0.01" max="999999999999" required/></div><button>Lưu hạn mức</button></form><p class="note">Ngân sách không chuyển dư sang tháng sau. Cảnh báo không chặn khoản chi đã phát sinh.</p></section>