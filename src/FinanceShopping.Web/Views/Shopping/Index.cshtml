@model List<ShoppingList>
@{ViewData["Title"]="Mua sắm";var vi=CultureInfo.GetCultureInfo("vi-VN");}
<div class="topline"><div><h1>Kế hoạch mua sắm</h1><span class="muted">Dự kiến trước khi mua, ghi chi khi xác nhận.</span></div><a class="button" asp-action="Edit">+ Tạo danh sách</a></div><div class="grid">@foreach(var l in Model){<section class="panel"><span class="badge">@(l.IsPurchased?"Đã mua":"Chưa mua")</span><h2 style="margin-top:12px">@l.Name</h2><p class="muted">Dự kiến tháng @l.PlannedMonth.ToString("MM/yyyy") · @l.Items.Count mặt hàng</p><p>Tổng dự kiến: <strong>@FinanceService.Estimate(l.Items).ToString("#,##0.##",vi) ₫</strong></p><a class="button secondary" asp-action="Details" asp-route-id="@l.Id">Xem chi tiết</a></section>}</div>@if(Model.Count==0){<div class="panel empty">Chưa có danh sách mua sắm. Hãy tạo kế hoạch đầu tiên.</div>}