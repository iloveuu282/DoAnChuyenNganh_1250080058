@model ShoppingDetails
@{ViewData["Title"]=Model.List.Name;var l=Model.List;var vi=CultureInfo.GetCultureInfo("vi-VN");string Money(decimal n)=>n.ToString("#,##0.##",vi)+" ₫";}
<div class="topline"><div><h1>@l.Name</h1><span class="muted">Tháng dự kiến: @l.PlannedMonth.ToString("MM/yyyy")</span> <span class="badge">@(l.IsPurchased?"Đã mua":"Chưa mua")</span></div><a asp-action="Index">← Danh sách</a></div>
<div class="grid"><div class="panel stat"><div class="label">Tổng chi phí dự kiến</div><div class="value">@Money(Model.Estimate)</div></div><div class="panel stat"><div class="label">Ngân sách còn lại · tháng dự kiến</div><div class="value">@(Model.Remaining.HasValue?Money(Model.Remaining.Value):"Chưa thiết lập")</div></div></div>
@if(!l.IsPurchased){<p class="notice @(Model.Remaining.HasValue&&Model.Estimate>Model.Remaining.Value?"warning":"success")">@(Model.Remaining.HasValue?(Model.Estimate>Model.Remaining.Value?"Chi phí dự kiến vượt ngân sách còn lại.":"Riêng danh sách này nằm trong ngân sách còn lại."):"Chưa thiết lập ngân sách nên chưa thể đối chiếu.") Chi phí dự kiến chưa làm thay đổi số dư hoặc ngân sách.</p>}
<section class="panel"><h2>Kế hoạch tháng @l.PlannedMonth.ToString("MM/yyyy")</h2><p>Tổng dự kiến của tất cả danh sách chưa mua: <strong>@Money(Model.PlannedTotal)</strong>.</p>
@if(Model.Remaining.HasValue){var projected=Model.Remaining.Value-Model.PlannedTotal;<p class="notice @(projected<0?"warning":"success")">@(projected<0?$"Tổng kế hoạch vượt ngân sách còn lại {Money(-projected)}.":$"Sau khi dự trù các danh sách, còn {Money(projected)}.") Đây là dự trù, không phải khoản chi đã ghi nhận.</p>}else{<p class="notice">Chưa thiết lập ngân sách tháng nên chưa thể đánh giá tổng kế hoạch.</p>}
<p class="note">Chỉ cộng danh sách chưa mua của tháng dự kiến. Danh sách đã mua được tính qua khoản chi theo ngày thực tế, tránh tính trùng. Nếu đổi tháng mua thực tế, cần đối chiếu ngân sách tháng đó.</p></section>
<section class="panel table-wrap"><h2>Mặt hàng dự kiến</h2><table><thead><tr><th>Mặt hàng / ưu tiên</th><th class="number">Số lượng</th><th class="number">Đơn giá</th><th class="number">Thành tiền</th>@if(!l.IsPurchased){<th>Thao tác</th>}</tr></thead><tbody>@foreach(var i in l.Items.OrderByDescending(x=>x.Priority).ThenBy(x=>x.Id)){<tr><td>@i.Name<br/><span class="note">@(i.Priority==Priority.High?"Ưu tiên cao":i.Priority==Priority.Low?"Ưu tiên thấp":"Bình thường")</span></td><td class="number">@i.Quantity.ToString("0.##",vi)</td><td class="number">@Money(i.EstimatedPrice)</td><td class="number">@Money(FinanceService.ItemEstimate(i))</td>@if(!l.IsPurchased){<td><details class="item-editor"><summary>Chỉnh sửa</summary><form asp-action="SaveItem" method="post"><input type="hidden" name="Id" value="@i.Id"/><input type="hidden" name="ShoppingListId" value="@l.Id"/><input type="hidden" name="Version" value="@l.Version"/><div class="field"><label>Tên mặt hàng<input name="Name" value="@i.Name" required maxlength="150"/></label></div><div class="field"><label>Số lượng<input name="Quantity" type="number" value="@i.Quantity.ToString(CultureInfo.InvariantCulture)" min="0.01" max="999999" step="0.01" required/></label></div><div class="field"><label>Đơn giá dự kiến<input name="EstimatedPrice" type="number" value="@i.EstimatedPrice.ToString(CultureInfo.InvariantCulture)" min="0" max="999999999999" step="0.01" required/></label></div><div class="field"><label>Mức ưu tiên<select name="Priority"><option value="1" selected="@(i.Priority==Priority.Low)">Thấp</option><option value="2" selected="@(i.Priority==Priority.Normal)">Bình thường</option><option value="3" selected="@(i.Priority==Priority.High)">Cao</option></select></label></div><button class="small">Lưu mặt hàng</button></form></details><form asp-action="DeleteItem" method="post" data-confirm="Xóa mặt hàng này?"><input type="hidden" name="id" value="@l.Id"/><input type="hidden" name="itemId" value="@i.Id"/><input type="hidden" name="version" value="@l.Version"/><button class="danger small">Xóa</button></form></td>}</tr>}</tbody></table>@if(l.Items.Count==0){<p class="empty">Danh sách chưa có mặt hàng.</p>}</section>
@if(!l.IsPurchased){
<section class="panel"><h2>Thêm mặt hàng</h2><form asp-action="SaveItem" method="post"><input name="ShoppingListId" value="@l.Id" type="hidden"/><input name="Version" value="@l.Version" type="hidden"/><div class="grid"><div class="field"><label for="item-name">Tên mặt hàng</label><input name="Name" id="item-name" required maxlength="150"/></div><div class="field"><label for="quantity">Số lượng</label><input name="Quantity" id="quantity" value="1" type="number" step="0.01" min="0.01" max="999999" required/></div><div class="field"><label for="price">Đơn giá dự kiến (VND)</label><input name="EstimatedPrice" id="price" value="0" type="number" step="0.01" min="0" max="999999999999" required/></div><div class="field"><label for="priority">Ưu tiên</label><select name="Priority" id="priority"><option value="2">Bình thường</option><option value="3">Cao</option><option value="1">Thấp</option></select></div></div><button>+ Thêm mặt hàng</button></form></section>
<section class="panel"><h2>Xác nhận đã mua</h2><p class="note">Xác nhận toàn bộ danh sách, tạo một khoản chi theo ngày mua thực tế. Chọn một ví và một danh mục chi.</p><form asp-action="Confirm" method="post" data-confirm="Xác nhận đã mua toàn bộ danh sách và tạo một khoản chi?"><input name="Id" value="@l.Id" type="hidden"/><input name="Version" value="@l.Version" type="hidden"/><div class="grid"><div class="field"><label for="actual">Tổng tiền thực tế (VND)</label><input name="Amount" id="actual" type="number" step="0.01" min="0.01" max="999999999999" value="@Model.Estimate.ToString(CultureInfo.InvariantCulture)" required/></div><div class="field"><label for="purchase-date">Ngày mua thực tế</label><input name="Date" id="purchase-date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" min="1900-01-01" max="2100-12-31" required/></div><div class="field"><label for="purchase-wallet">Ví thanh toán</label><select name="WalletId" id="purchase-wallet" required><option value="">Chọn ví</option>@foreach(var w in Model.Wallets){<option value="@w.Id">@w.Name</option>}</select></div><div class="field"><label for="purchase-category">Danh mục chi</label><select name="CategoryId" id="purchase-category" required><option value="">Chọn danh mục</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name (#@c.Id)</option>}</select></div></div><button>Xác nhận đã mua</button></form></section>
<div class="actions"><a class="button secondary" asp-action="Edit" asp-route-id="@l.Id">Sửa tên / tháng dự kiến</a><form asp-action="Delete" method="post" data-confirm="Xóa danh sách và toàn bộ mặt hàng?"><input name="id" value="@l.Id" type="hidden"/><input name="version" value="@l.Version" type="hidden"/><button class="danger">Xóa danh sách</button></form></div>
}else if(l.Purchase is Transaction purchase){<section class="panel"><h2>Kết quả mua sắm</h2><div class="grid"><p>Dự kiến: <strong>@Money(Model.Estimate)</strong></p><p>Thực tế: <strong>@Money(purchase.Amount)</strong></p><p>Chênh lệch: <strong>@Money(purchase.Amount-Model.Estimate)</strong></p></div><p>Ngày mua: @purchase.Date.ToString("dd/MM/yyyy") · Mã giao dịch: #@purchase.Id</p><p>Ví: @Model.Wallets.FirstOrDefault(x=>x.Id==purchase.WalletId)?.Name · Danh mục: @Model.Categories.FirstOrDefault(x=>x.Id==purchase.CategoryId)?.Name</p><p class="note">Khoản chi thuộc tháng của ngày mua thực tế. Hủy xác nhận chỉ dùng để sửa ghi nhận nhầm và xóa khoản chi liên kết; không mô tả trả hàng hoặc hoàn tiền thực tế. Hệ thống chưa lưu lịch sử hủy. Muốn điều chỉnh số tiền, hủy ghi nhận sai rồi xác nhận lại số đúng.</p><form asp-action="Cancel" method="post" data-confirm="Hủy xác nhận mua? Khoản chi liên kết sẽ được xóa và danh sách trở về chưa mua."><input name="id" value="@l.Id" type="hidden"/><input name="version" value="@l.Version" type="hidden"/><button class="danger">Hủy xác nhận mua</button></form></section>}
